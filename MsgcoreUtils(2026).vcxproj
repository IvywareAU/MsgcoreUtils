  <!-- =====================================================================
       DebugLib / ReleaseLib - the archive form.

       _AFXEXT is absent for the reason Msgcore(2026).vcxproj records: it declares an MFC
       EXTENSION DLL, and an archive is not a module. Msgcore_STATIC and
       MsgcoreUtils_STATIC are BOTH present - the first tells Msgcore's headers not to
       decorate the symbols this archive calls, the second tells this module's headers
       not to decorate the ones it defines.

       UseOfMfc stays Dynamic and RuntimeLibrary stays /MD: an archive must be compiled
       against exactly the MFC and CRT the consumer absorbing it uses.

       The PostBuildEvent stages the archive into $(WDMSCS_LIB) because the Lib tool has
       no <ImportLibrary> equivalent to do it - the same explicit copy Msgcore makes.
       ===================================================================== -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='DebugLib|Win32'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_DEBUG;Msgcore_STATIC;MsgcoreUtils_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <DebugInformationFormat>EditAndContinue</DebugInformationFormat>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
    </ClCompile>
    <Lib>
      <OutputFile>$(OutDir)$(TargetName).lib</OutputFile>
    </Lib>
    <PostBuildEvent>
      <Command>if not exist "$(WDMSCS_LIB)" mkdir "$(WDMSCS_LIB)"
copy /Y "$(OutDir)$(TargetName).lib" "$(WDMSCS_LIB)\$(TargetName).lib"</Command>
      <Message>Staging static $(TargetName).lib to $(WDMSCS_LIB)</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
